{
  "name": "hljod-smali",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp dev",
    "dev:local": "export LOCAL_WEB_AUDIO=1 && vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check --fix",
    "last": "vp run --last-details",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:audiopipe": "AUDIOPIPE=1 playwright test tests/audio-pipe.spec.ts",
    "test:all": "vpr check && vp build && vp test && vpr test:e2e",
    "test:all:local": "export LOCAL_WEB_AUDIO=1 && vpr test:all",
    "deploy:gh": "vp check && vp build && gh-pages -d dist -b gh-pages",
    "deploy:gh:local": "export LOCAL_WEB_AUDIO=1 && vpr deploy:gh",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@kidlib/web-audio": "^0.6.2",
    "dexie": "^4.4.6",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "fake-indexeddb": "^6.2.6",
    "gh-pages": "^6.3.0",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "catalog:",
    "webmcp-types": "^0.1.10",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.11.0"
}
